 RowBox[{
  RowBox[{
   RowBox[{"hTetrad", "[", 
    RowBox[{
     RowBox[{"r0_", "?", "NumericQ"}], ",", 
     RowBox[{"c0_", "?", "NumericQ"}], ",", 
     RowBox[{"ij", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_Integer", "?", "NonNegative"}], ",", 
        RowBox[{"_Integer", "?", "NonNegative"}]}], "}"}], ":", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lmb", ",", "mbmb", ",", "h", ",", "hc", ",", "s"}], "}"}], ",", 
     RowBox[{
      RowBox[{"check", "[", "]"}], ";", 
      RowBox[{"lmb", "=", 
       RowBox[{"hComp0", "[", 
        RowBox[{"\"\<hlmb\>\"", ",", "r0", ",", "c0", ",", "ij"}], "]"}]}], ";", 
      RowBox[{"mbmb", "=", 
       RowBox[{"hComp0", "[", 
        RowBox[{"\"\<hmbmb\>\"", ",", "r0", ",", "c0", ",", "ij"}], "]"}]}], ";", 
      RowBox[{"h", "=", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<ll\>\"", "\[Rule]", 
          RowBox[{"hComp0", "[", 
           RowBox[{"\"\<hll\>\"", ",", "r0", ",", "c0", ",", "ij"}], "]"}]}], 
         ",", 
         RowBox[{"\"\<lm\>\"", "\[Rule]", 
          RowBox[{"Conjugate", "[", "lmb", "]"}]}], ",", 
         RowBox[{"\"\<lmb\>\"", "\[Rule]", "lmb"}], ",", 
         RowBox[{"\"\<mm\>\"", "\[Rule]", 
          RowBox[{"Conjugate", "[", "mbmb", "]"}]}], ",", 
         RowBox[{"\"\<mbmb\>\"", "\[Rule]", "mbmb"}], ",", 
         RowBox[{"\"\<mmb\>\"", "\[Rule]", 
          RowBox[{"hComp0", "[", 
           RowBox[{"\"\<hmmb\>\"", ",", "r0", ",", "c0", ",", "ij"}], 
           "]"}]}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"OptionValue", "[", "\"\<Completion\>\"", "]"}], "]"}], ",", 
        
        RowBox[{
