            RowBox[{"\"\<lm\>\"", "\[Rule]", 
             RowBox[{
              RowBox[{"h", "[", "\"\<lm\>\"", "]"}], "+", 
              RowBox[{"hc", "[", "\"\<lm\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<lmb\>\"", "\[Rule]", 
             RowBox[{
              RowBox[{"h", "[", "\"\<lmb\>\"", "]"}], "+", 
              RowBox[{"hc", "[", "\"\<lmb\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<mm\>\"", "\[Rule]", 
             RowBox[{"h", "[", "\"\<mm\>\"", "]"}]}], ",", 
            RowBox[{"\"\<mbmb\>\"", "\[Rule]", 
             RowBox[{"h", "[", "\"\<mbmb\>\"", "]"}]}], ",", 
            RowBox[{"\"\<mmb\>\"", "\[Rule]", 
             RowBox[{"h", "[", "\"\<mmb\>\"", "]"}]}]}], "]"}]}]}]}], "]"}], ";", 
      RowBox[{"s", "=", 
       RowBox[{"ampF", "[", 
        RowBox[{"OptionValue", "[", "\"\<Amplitude\>\"", "]"}], "]"}]}], ";", 
      
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", " ", "#1"}], "&"}], ")"}], "/@", "h"}]}]}], "]"}]}], 
