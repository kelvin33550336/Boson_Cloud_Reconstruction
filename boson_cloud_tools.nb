Cell["\<\
|\[CapitalPhi]| in the meridional plane (x = r sin\[Theta], z = r \
cos\[Theta]; Boyer-Lindquist-like radius r, black disk r < r+):\
\>", "Text",ExpressionUUID->"6e0eea69-bda7-4f8a-839b-36a69ad5faf3"],

Cell[CellGroupData[{

Cell["\<\
With[{R = rMaxPlot/2.5},
 DensityPlot[With[{r = Sqrt[x^2 + z^2]}, If[r <= rp0, 0, nrm0 Abs[fI[r] \
SI[z/r]]]], {x, 0, R}, {z, -R, R}, PlotPoints -> 60, AspectRatio -> 2,
  ColorFunction -> \"SunsetColors\", PlotLegends -> Automatic, FrameLabel -> \
{\"x\", \"z\"}, Epilog -> {Black, Disk[{0, 0}, rp0]}]]\
\>", "Input",
 CellLabel->
  "In[218]:=",ExpressionUUID->"e8018ce0-dafa-4fb2-a0c7-707134ff1b96"],

