Cell["\<\
Radial profiles of |A^2 h| at \[Chi] = 0.21 (r - r+ from 10^-4 to 10^4):\
\>", "Text",ExpressionUUID->"7bac62c7-5976-4480-9cce-56ab2d1fcf39"],

Cell[CellGroupData[{

Cell["\<\
With[{rp = bcmParameters[][\"rplus\"]},
 ListLogLogPlot[Table[Table[{x, Abs[hComponent[c, rp + x, 21/100]]}, {x, \
10^Range[-4, 2, 1/20]}], {c, {\"hmbmb\", \"hmmb\", \"hlmb\", \"hll\"}}],
  Joined -> True, PlotLegends -> {\"|h_mbmb|\", \"|h_mmb|\", \"|h_lmb|\", \
\"|h_ll|\"}, Frame -> True, FrameLabel -> {\"r - r+\", \"|A^2 h|\"}, \
PlotRange -> All]]\
\>", "Input",
 CellChangeTimes->{{4.001694585261077*^9, 4.001694607489319*^9}},
 CellLabel->
  "In[207]:=",ExpressionUUID->"61991b75-c937-4c69-b644-3615925ec508"],

