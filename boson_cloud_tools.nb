Cell["\<\
Re \[CapitalPhi] in the equatorial plane at v = 0 (ingoing coordinates: the \
phase m \[CurlyPhi]~ + \[CapitalTheta](r), \[CapitalTheta] = \[Omega] (r + 2 \
Log[r - r-]), gives the spiral; in Boyer-Lindquist time slices the pattern is \
the plain dipole cos(\[Omega]t - m\[CurlyPhi])):\
\>", "Text",ExpressionUUID->"24950bcb-4cee-44f7-b021-e1fafd74e95a"],

Cell[CellGroupData[{

Cell["\<\
With[{R = rMaxPlot/2.5},
 DensityPlot[With[{r = Sqrt[x^2 + y^2]}, If[r <= rp0, 0, nrm0 fI[r] SI[0] \
Cos[mm0 ArcTan[x, y] + om0 (r + 2 Log[r - rm0])]]], {x, -R, R}, {y, -R, R}, \
PlotPoints -> 80,
  ColorFunction -> \"TemperatureMap\", PlotLegends -> Automatic, FrameLabel \
-> {\"x\", \"y\"}, Epilog -> {Black, Disk[{0, 0}, rp0]}]]\
\>", "Input",
 CellLabel->
  "In[219]:=",ExpressionUUID->"164eec7c-35ed-4714-84c4-3228b232e732"],

