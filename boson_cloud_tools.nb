Cell["Examples: scalar field", "Section",ExpressionUUID->"4cddb3ae-ec72-4f6a-a9d1-8f6f232aad2a"],

Cell["\<\
Values (physical normalization unless stated; shown to 15 digits, the \
functions return the full working-precision values):\
\>", "Text",ExpressionUUID->"2bbe0b63-1517-442a-b4c7-c7036e278363"],

Cell[CellGroupData[{

Cell["\<\
N[phiCloud[0, 3, 1/2, 0], 15]
N[phiAbs[3, 1/2], 15]
N[Table[fRadial[3, d], {d, 0, 3}], 15]
N[Table[SAngular[1/2, d], {d, 0, 3}], 15]\
\>", "Input",
 CellChangeTimes->{{4.001694598469445*^9, 4.001694611539934*^9}},
