Cell["\<\
For plots the radial function is tabulated once and interpolated (the series \
has ~10^4-10^5 terms at working precision); fI[r] = f(r) on r+ < r < rMaxPlot:\
\>", "Text",ExpressionUUID->"9549a6c8-deb1-44c5-928b-ca2d8e052475"],

Cell["\<\
With[{p = scalarParameters[]}, rp0 = N[p[\"rplus\"]]; mm0 = p[\"m\"]; om0 = \
N[p[\"omega\"]]; rm0 = N[p[\"rminus\"]]; nrm0 = N[p[\"N_Physical\"]]];
rMaxPlot = 25/Abs[N[scalarParameters[][\"q\"]]];          (* |\[CapitalPhi]| \
~ e^{q r}: 25 e-folds *)
(* nodes from the full-precision r+ (a machine r+ can round below the \
horizon) *)
fI = With[{rpX = scalarParameters[][\"rplus\"]}, Interpolation[Table[{N[x], \
N[fRadial[x]]}, {x, rpX + (rMaxPlot - rpX) Subdivide[0, 1, 600]^2}], \
InterpolationOrder -> 3]];
SI[c_] := N[SAngular[c]];\
\>", "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"ba131924-1a26-4127-a325-03a8a27fa747"],

Cell["\<\
Radial profile of |\[CapitalPhi]| on the equator and on \[Chi] = 0.8 (r - r+ \
on a log axis):\
\>", "Text",ExpressionUUID->"52d341af-65bc-490c-92d6-4229524cd3ff"],

Cell[CellGroupData[{

Cell["\<\
LogLinearPlot[{nrm0 Abs[fI[rp0 + x] SI[0]], nrm0 Abs[fI[rp0 + x] SI[4/5]]}, \
{x, 10^-3, rMaxPlot - rp0}, PlotRange -> All, Frame -> True,
 FrameLabel -> {\"r - r+\", \"|\[CapitalPhi]|\"}, PlotLegends -> {\"\[Chi] = \
0\", \"\[Chi] = 0.8\"}]\
\>", "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"0576b81e-ba37-4750-865b-c73e60f6e591"],

